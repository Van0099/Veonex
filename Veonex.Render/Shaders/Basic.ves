
###VERT
#version 450

layout(location = 0) in vec3 Position;
layout(location = 1) in vec3 Normal;
layout(location = 2) in vec2 UV;

layout(set = 0, binding = 0) uniform CameraBuffer
{
    mat4 ViewProjection;
};

layout(location = 3) in vec4 InstanceRow0;
layout(location = 4) in vec4 InstanceRow1;
layout(location = 5) in vec4 InstanceRow2;
layout(location = 6) in vec4 InstanceRow3;
layout(location = 7) in vec4 InstanceNormalRow0;
layout(location = 8) in vec4 InstanceNormalRow1;
layout(location = 9) in vec4 InstanceNormalRow2;

layout(set = 2, binding = 3) uniform ShadowMatrixBuffer
{
    mat4 LightViewProjection;
};

layout(location = 0) out vec3 FragNormal;
layout(location = 1) out vec2 FragUV;
layout(location = 2) out vec4 FragShadowPosition;

void main()
{
    mat4 model = mat4(
        InstanceRow0,
        InstanceRow1,
        InstanceRow2,
        InstanceRow3);

    vec4 worldPosition = model * vec4(Position, 1.0);
    gl_Position = ViewProjection * worldPosition;

    mat3 normalMatrix = mat3(
        InstanceNormalRow0.xyz,
        InstanceNormalRow1.xyz,
        InstanceNormalRow2.xyz);

    FragNormal = normalize(normalMatrix * Normal);
    FragUV = UV;
    FragShadowPosition = LightViewProjection * worldPosition;
}

###FRAG
#version 450

layout(set = 1, binding = 0) uniform MaterialBuffer
{
    vec4 AlbedoColor;
    vec4 EmissionColor;
    vec4 MaterialParameters;
};

layout(set = 1, binding = 1) uniform texture2D AlbedoTexture;
layout(set = 1, binding = 2) uniform sampler AlbedoSampler;

layout(set = 2, binding = 0) uniform LightingBuffer
{
    vec4 LightDirection;
    vec4 LightColorIntensity;
    vec4 ShadowParameters;
};

layout(set = 2, binding = 1) uniform texture2D ShadowMap;
layout(set = 2, binding = 2) uniform sampler ShadowSampler;

layout(location = 0) in vec3 FragNormal;
layout(location = 1) in vec2 FragUV;
layout(location = 2) in vec4 FragShadowPosition;

layout(location = 0) out vec4 OutColor;


float CalculateShadow(vec4 shadowPosition, vec3 normal, vec3 lightDirection)
{
    if (ShadowParameters.x < 0.5 || shadowPosition.w <= 0.0)
        return 1.0;

    vec3 projected = shadowPosition.xyz / shadowPosition.w;

    if (projected.x < -1.0 || projected.x > 1.0 ||
        projected.y < -1.0 || projected.y > 1.0 ||
        projected.z < 0.0 || projected.z > 1.0)
        return 1.0;

    vec2 shadowUV = projected.xy * 0.5 + 0.5;

    if (ShadowParameters.y > 0.5)
        shadowUV.y = 1.0 - shadowUV.y;

    float normalBias = 1.0 - max(dot(normal, lightDirection), 0.0);
    float bias = max(ShadowParameters.z * normalBias, ShadowParameters.z * 0.2);

    vec2 texelSize = 1.0 / vec2(textureSize(sampler2D(ShadowMap, ShadowSampler), 0));

    float shadow = 0.0;

    for (int y = -1; y <= 1; y++)
    {
        for (int x = -1; x <= 1; x++)
        {
            vec2 sampleUV = shadowUV + vec2(x, y) * texelSize;

            float closestDepth = texture(
                sampler2D(ShadowMap, ShadowSampler),
                sampleUV).r;

            shadow += projected.z - bias > closestDepth ? 0.0 : 1.0;
        }
    }

    return shadow / 9.0;
}


void main()
{
    vec3 normal = normalize(FragNormal);
    vec3 lightDirection = normalize(-LightDirection.xyz);

    float diffuse = max(
        dot(normal, lightDirection),
        0.0);

    float shadow = CalculateShadow(
        FragShadowPosition,
        normal,
        lightDirection);

    vec3 lighting =
        vec3(0.2) +
        diffuse *
        0.8 *
        LightColorIntensity.rgb *
        LightColorIntensity.a *
        shadow;

    vec4 textureColor = texture(
        sampler2D(AlbedoTexture, AlbedoSampler),
        FragUV);

    vec4 finalColor = textureColor * AlbedoColor;

    float opacity = clamp(
        MaterialParameters.x,
        0.0,
        1.0);

    float emissionStrength = max(
        MaterialParameters.y,
        0.0);

    vec3 emissive =
        EmissionColor.rgb * emissionStrength;

    OutColor = vec4(
        finalColor.rgb * lighting + emissive,
        finalColor.a * opacity);
}
