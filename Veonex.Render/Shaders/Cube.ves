###VERT

#version 450

layout(location = 0) in vec3 Position;
layout(location = 1) in vec3 VertexColor;

layout(location = 0) out vec3 FragColor;

void main()
{
    gl_Position = vec4(
        Position,
        1.0
    );

    FragColor = VertexColor;
}

###FRAG

#version 450

layout(location = 0) in vec3 FragColor;

layout(location = 0) out vec4 Color;

void main()
{
    Color = vec4(
        FragColor,
        1.0
    );
}