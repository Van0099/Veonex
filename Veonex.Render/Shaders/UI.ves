###VERT
#version 450

layout(location = 0) in vec2 Position;
layout(location = 1) in vec3 UV;
layout(location = 2) in vec4 Color;

layout(location = 0) out vec3 FragUV;
layout(location = 1) out vec4 FragColor;

void main()
{
    gl_Position = vec4(Position, 0.0, 1.0);
    FragUV = UV;
    FragColor = Color;
}

###FRAG
#version 450

layout(set = 0, binding = 0) uniform texture2D GlyphTexture;
layout(set = 0, binding = 1) uniform sampler GlyphSampler;

layout(location = 0) in vec3 FragUV;
layout(location = 1) in vec4 FragColor;

layout(location = 0) out vec4 OutputColor;

void main()
{
    vec4 sampled = texture(
        sampler2D(GlyphTexture, GlyphSampler),
        FragUV.xy);

    float glyphMode = step(0.5, FragUV.z);
    float glyphCoverage = mix(1.0, sampled.r, glyphMode);
    vec4 imageColor = mix(sampled, vec4(1.0), glyphMode);

    OutputColor = vec4(
        FragColor.rgb * imageColor.rgb,
        FragColor.a * imageColor.a * glyphCoverage);
}